# CONTINUUM Longitudinal Outreach Messaging Gateway Configuration Template
# Duplicate this file as .env in backend directory

# OPTION A: REAL EMAIL (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=Ministry of Skill Development & Entrepreneurship (CONTINUUM)

# OPTION B: REAL SMS (Fast2SMS for Indian Numbers)
FAST2SMS_API_KEY=

# OPTION C: REAL SMS (Twilio Alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MESSAGING MODE: 'mock' (safe simulation), 'smtp' (live email), 'fast2sms' (live SMS)
MESSAGING_PROVIDER=mock
