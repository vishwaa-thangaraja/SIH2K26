# CONTINUUM Longitudinal Outreach Messaging Gateway Configuration

# ----------------------------------------------------
# OPTION A: REAL EMAIL (Gmail SMTP)
# ----------------------------------------------------
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your gmail address and 16-character password below (remove spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=Ministry of Skill Development & Entrepreneurship

# ----------------------------------------------------
# OPTION B: REAL SMS (Fast2SMS - Indian Cellular Gateway)
# ----------------------------------------------------
# 1. Sign up free at https://www.fast2sms.com
# 2. Go to Dev API -> copy your Authorization API Key
# 3. Enter the key below:
FAST2SMS_API_KEY=

# ----------------------------------------------------
# OPTION C: REAL SMS (Twilio Cloud Gateway)
# ----------------------------------------------------
# 1. Sign up at https://www.twilio.com
# 2. Enter credentials below:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Messaging Provider override (optional: 'fast2sms', 'twilio', or default 'mock')
MESSAGING_PROVIDER=
